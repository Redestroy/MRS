# UAV behaviour library, version 0.1 (spec 03 §7).
# Each entry's C_3 ("until") is replaced at bind time by the unmet condition it was called for.
@: MRS 0.1/

# Take off: makes "airborne" TRUE.
B: B_E liftoff C_? airborne 10 T_1/
T_1: T_B 0 1 0 C_1 C_2 C_3 T_1/
C_1: C_N/
C_2: C_N/
C_3: C_? ?_1/
?_1: airborne T/
T_1: T_A 0 1 0 C_1 C_2 A_1..2/
C_1: C_N/
C_2: C_N/
A_1: A_TO 3 1.5/
A_2: A_N/

# Land where the robot is: makes "landed" TRUE.
B: B_E land C_? landed 10 T_1/
T_1: T_B 0 1 0 C_1 C_2 C_3 T_1/
C_1: C_N/
C_2: C_N/
C_3: C_? ?_1/
?_1: landed T/
T_1: T_A 0 1 0 C_1 C_2 A_1..2/
C_1: C_N/
C_2: C_N/
A_1: A_LD 0.7 0/
A_2: A_N/

# Fly home at the robot's layer: makes "home" TRUE.
B: B_E return_home C_? home 10 T_1/
T_1: T_B 0 1 0 C_1 C_2 C_3 T_1/
C_1: C_? ?_1/
?_1: airborne T/
C_2: C_N/
C_3: C_? ?_1/
?_1: home T/
T_1: T_P 0 1 0 C_1 C_2 A_1..2/
C_1: C_N/
C_2: C_N/
A_1: A_MAP any A_1 any A_2/
A_1: A_FN A_PXY F_1 F_2/
F_1: F_L 1 1 0 home.enu.x/
F_2: F_L 1 1 0 home.enu.y/
A_2: A_FN A_PZY F_1 F_2/
F_1: F_L 1 1 0 layer.alt/
F_2: F_L 1 1 0 att.yaw/
A_2: A_N/

# Default fly-to for groups: climb to the robot's layer, cross, descend at the target.
B: B_E flyto.layered C_P3 any 10 T_1/
T_1: T_B 0 1 0 C_1 C_2 C_3 T_1/
C_1: C_? ?_1/
?_1: airborne T/
C_2: C_N/
C_3: C_N/
T_1: T_P 0 1 0 C_1 C_2 A_1..2/
C_1: C_N/
C_2: C_N/
A_1: A_MAP any A_1 any A_2/
A_1: A_FN A_PXY F_1 F_2/
F_1: F_X layered_x 2 1 3/
F_2: F_X layered_y 2 1 3/
A_2: A_FN A_PZY F_1 F_2/
F_1: F_X layered_z 1 3/
F_2: F_X yaw_to_target 0/
A_2: A_N/

# Straight-line fly-to, for single robots or when layers are off.
B: B_E flyto.direct C_P3 any 5 T_1/
T_1: T_B 0 1 0 C_1 C_2 C_3 T_1/
C_1: C_? ?_1/
?_1: airborne T/
C_2: C_N/
C_3: C_N/
T_1: T_P 0 1 0 C_1 C_2 A_1..2/
C_1: C_N/
C_2: C_N/
A_1: A_MAP any A_1 any A_2/
A_1: A_FN A_PXY F_1 F_2/
F_1: F_L 1 1 0 target.x/
F_2: F_L 1 1 0 target.y/
A_2: A_FN A_PZY F_1 F_2/
F_1: F_L 1 1 0 target.z/
F_2: F_X yaw_to_target 0/
A_2: A_N/

# Climb to a cruise altitude (20 m, or the target's if higher), cross, descend at the target.
B: B_E flyto.altitude_first C_P3 any 4 T_1/
T_1: T_B 0 1 0 C_1 C_2 C_3 T_1/
C_1: C_? ?_1/
?_1: airborne T/
C_2: C_N/
C_3: C_N/
T_1: T_P 0 1 0 C_1 C_2 A_1..2/
C_1: C_N/
C_2: C_N/
A_1: A_MAP any A_1 any A_2/
A_1: A_FN A_PXY F_1 F_2/
F_1: F_X cruise_x 3 20 1 3/
F_2: F_X cruise_y 3 20 1 3/
A_2: A_FN A_PZY F_1 F_2/
F_1: F_X cruise_z 2 20 3/
F_2: F_X yaw_to_target 0/
A_2: A_N/

# Fly to the target by velocity setpoints (gain 0.8 per s, at most 6 m/s across and 1.5 m/s up or down).
B: B_E flyto.velocity C_P3 any 3 T_1/
T_1: T_B 0 1 0 C_1 C_2 C_3 T_1/
C_1: C_? ?_1/
?_1: airborne T/
C_2: C_N/
C_3: C_N/
T_1: T_P 0 1 0 C_1 C_2 A_1..2/
C_1: C_N/
C_2: C_N/
A_1: A_MAP any A_1 any A_2/
A_1: A_FN A_VXY F_1 F_2/
F_1: F_X vel_to_target_x 2 0.8 6/
F_2: F_X vel_to_target_y 2 0.8 6/
A_2: A_FN A_VZY F_1 F_2/
F_1: F_X vel_to_target_z 2 0.8 1.5/
F_2: F_K 0/
A_2: A_N/

# Emergency landing where the robot is (spec 08 §4). Pushed by the robot controller, never
# chosen to fulfil "landed" while "land" has the higher priority.
B: B_E emergency_land C_? landed 1 T_1/
T_1: T_B 0 1 0 C_1 C_2 C_3 T_1/
C_1: C_N/
C_2: C_N/
C_3: C_? ?_1/
?_1: landed T/
T_1: T_A 0 1 0 C_1 C_2 A_1..3/
C_1: C_N/
C_2: C_N/
A_1: A_HD 1 0/
A_2: A_LD 1 0/
A_3: A_N/

# Change altitude in place.
B: B_E change_altitude C_H any 10 T_1/
T_1: T_B 0 1 0 C_1 C_2 C_3 T_1/
C_1: C_? ?_1/
?_1: airborne T/
C_2: C_N/
C_3: C_N/
T_1: T_P 0 1 0 C_1 C_2 A_1..2/
C_1: C_N/
C_2: C_N/
A_1: A_FN A_PZY F_1 F_2/
F_1: F_L 1 1 0 target.z/
F_2: F_L 1 1 0 att.yaw/
A_2: A_N/

# Wait in place (fulfils elapsed-time and absolute-time conditions).
B: B_E hover C_W any 10 T_1/
T_1: T_B 0 1 0 C_1 C_2 C_3 T_1/
C_1: C_N/
C_2: C_N/
C_3: C_N/
T_1: T_A 0 1 0 C_1 C_2 A_1..2/
C_1: C_N/
C_2: C_N/
A_1: A_HD 0 0/
A_2: A_N/

B: B_E hover_until C_T any 10 T_1/
T_1: T_B 0 1 0 C_1 C_2 C_3 T_1/
C_1: C_N/
C_2: C_N/
C_3: C_N/
T_1: T_A 0 1 0 C_1 C_2 A_1..2/
C_1: C_N/
C_2: C_N/
A_1: A_HD 0 0/
A_2: A_N/

# Ask the peers (spec 15 §2.5): for a condition on world fields or detections that is FALSE or
# UNKNOWN, ask every live peer for them and wait up to 2 s. Only what arrives can make the
# condition TRUE; no answer fails with NOT_KNOWN, and the next entry (if any) is tried.
B: B_E sync.view C_V sync 50 T_1/
T_1: T_B 0 1 0 C_1 C_2 C_3 T_1/
C_1: C_N/
C_2: C_N/
C_3: C_N/
T_1: T_A 0 1 0 C_1 C_2 A_1..2/
C_1: C_N/
C_2: C_N/
A_1: A_SY 2/
A_2: A_N/

B: B_E sync.field C_m sync 50 T_1/
T_1: T_B 0 1 0 C_1 C_2 C_3 T_1/
C_1: C_N/
C_2: C_N/
C_3: C_N/
T_1: T_A 0 1 0 C_1 C_2 A_1..2/
C_1: C_N/
C_2: C_N/
A_1: A_SY 2/
A_2: A_N/

B: B_E sync.logic C_L sync 50 T_1/
T_1: T_B 0 1 0 C_1 C_2 C_3 T_1/
C_1: C_N/
C_2: C_N/
C_3: C_N/
T_1: T_A 0 1 0 C_1 C_2 A_1..2/
C_1: C_N/
C_2: C_N/
A_1: A_SY 2/
A_2: A_N/

# --- Package delivery (spec 18 §3) ---------------------------------------------------------

# Pick up: descend slowly where the robot is until the passive hook catches a package's loop
# (payload.held). Fails after 30 s without a catch, or when the robot is down to 2.2 m above the
# ground: the hook is then on the ground beside the pile (spec 18 §9.3).
B: B_E pickup C_? payload.held 10 T_1/
T_1: T_B 0 1 0 C_1 C_2 C_3 R_1 T_1/
C_1: C_? ?_1/
?_1: airborne T/
C_2: C_N/
C_3: C_N/
R_1: R_S R_1 R_2/
R_1: R_C C_1/
C_1: C_L 3 C_1/
C_1: C_W 30/
R_2: R_C C_1/
C_1: C_m alt.agl gt 2.2 0/
T_1: T_A 0 1 0 C_1 C_2 A_1..2/
C_1: C_N/
C_2: C_N/
A_1: A_VZY -0.3 0/
A_2: A_N/

# Package flight: towards payload.goal (a via point, then the destination read from the tag)
# at the robot's layer, with the setpoint at most 5.5 m ahead (about 5 m/s), while the package
# stays on the hook.
B: B_E flyto.package C_? payload.at_dest 10 T_1/
T_1: T_B 0 1 0 C_1 C_2 C_3 R_1 T_1/
C_1: C_? ?_1/
?_1: airborne T/
C_2: C_N/
C_3: C_N/
R_1: R_C C_1/
C_1: C_? ?_1/
?_1: payload.held T/
T_1: T_P 0 1 0 C_1 C_2 A_1..2/
C_1: C_N/
C_2: C_N/
A_1: A_MAP any A_1 any A_2/
A_1: A_FN A_PXY F_1 F_2/
F_1: F_X pkg_x 3 1 3 5.5/
F_2: F_X pkg_y 3 1 3 5.5/
A_2: A_FN A_PZY F_1 F_2/
F_1: F_X pkg_z 1 3/
F_2: F_X yaw_to_goal 0/
A_2: A_N/

# Lower the package to the ground: descend slowly until the line goes slack (payload.grounded).
# Fails after 40 s, or when the package is lost.
B: B_E lower_package C_? payload.grounded 10 T_1/
T_1: T_B 0 1 0 C_1 C_2 C_3 R_1 T_1/
C_1: C_? ?_1/
?_1: airborne T/
C_2: C_N/
C_3: C_N/
R_1: R_S R_1 R_2/
R_1: R_C C_1/
C_1: C_? ?_1/
?_1: payload.held T/
R_2: R_C C_1/
C_1: C_L 3 C_1/
C_1: C_W 40/
T_1: T_A 0 1 0 C_1 C_2 A_1..2/
C_1: C_N/
C_2: C_N/
A_1: A_VZY -0.4 0/
A_2: A_N/

# Wait in line for a zone (spec 18 §4.3): ask for zone target.arg (the number in the predicate's
# name, or zone.dest.id), go to the zone's holding point and hold at the robot's place in the
# stack until the zone is this robot's.
B: B_E wait_in_line C_? zone._.mine 10 T_1/
T_1: T_B 0 1 0 C_1 C_2 C_3 T_1/
C_1: C_? ?_1/
?_1: airborne T/
C_2: C_N/
C_3: C_N/
T_1: T_P 0 1 0 C_1 C_2 A_1..3/
C_1: C_N/
C_2: C_N/
A_1: A_FN A_ZQ F_1/
F_1: F_L 1 1 0 target.arg/
A_2: A_MAP any A_1 any A_2/
A_1: A_FN A_PXY F_1 F_2/
F_1: F_X zone_hold_x 2 1 3/
F_2: F_X zone_hold_y 2 1 3/
A_2: A_FN A_PZY F_1 F_2/
F_1: F_X zone_hold_z 2 1 3/
F_2: F_L 1 1 0 att.yaw/
A_3: A_N/
