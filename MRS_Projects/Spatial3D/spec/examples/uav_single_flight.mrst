# One UAV, one flight (spec 08, WP4 acceptance): take off, fly to a point, flash the LEDs, land.
# The fly-to and the landing are start conditions; the behaviour library fulfils them.
@: MRS 0.1/

# Take off to 5 m at 1.5 m/s.
T: T_A sf.1 1 0 C_1 C_2 A_1..2/
C_1: C_N/
C_2: C_? ?_1/
?_1: airborne T/
A_1: A_TO 5 1.5/
A_2: A_N/

# Fly to (40, 20, 10), flash the LEDs green for 1 s.
T: T_A sf.2 1 0 C_1 C_2 A_1..4/
C_1: C_P3 40 20 10 1 0.5 0 -1/
C_2: C_N/
A_1: A_L 3 65280/
A_2: A_W 1/
A_3: A_L 3 0/
A_4: A_N/

# Land where the robot is.
T: T_A sf.3 1 0 C_1 C_2 A_1/
C_1: C_? ?_1/
?_1: landed T/
C_2: C_N/
A_1: A_N/
