# Port map for quad_ardupilot_host.mrsd (spec 16 §4.2): the link is on the platform, the rest via the autopilot.
@: MRS 0.2/
P: P_A ap link TCP "127.0.0.1:5760" 0/
P: P_A m_fl motor MAVLINK "SERVO:3" 1 via ap/
P: P_A m_fr motor MAVLINK "SERVO:1" 1 via ap/
P: P_A m_rl motor MAVLINK "SERVO:2" 1 via ap/
P: P_A m_rr motor MAVLINK "SERVO:4" 1 via ap/
P: P_A fcu guided MAVLINK "GUIDED" 1 via ap/
P: P_A imu inertial MAVLINK "ATTITUDE" 1 via ap/
P: P_A imu gyro MAVLINK "ATTITUDE_RATES" 1 via ap/
P: P_A gnss gnss MAVLINK "GLOBAL_POSITION_INT" 1 via ap/
P: P_A vel velocity MAVLINK "VELOCITY" 1 via ap/
P: P_A leds led0 MAVLINK "RELAY:0" 1 via ap/
P: P_A leds led1 MAVLINK "RELAY:1" 1 via ap/
P: P_A bat battery MAVLINK "BATTERY_STATUS" 1 via ap/
