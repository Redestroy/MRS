# Webots DJI Mavic 2 Pro as a device tree (spec 04 §2.4).
# quadrotor.webots expands to m_fl, m_fr, m_rl, m_rr, fcu, imu, gnss, baro, compass.
@: MRS 0.1/

D: D_H uav head.default 3 robot_type mavic2pro role camera_uav id 1 D_1/
D_1: D_J frame mech_bus 0 D_1..4/
D_1: D_X quadrotor quadrotor.webots 2 max_climb 2 max_speed_xy 8/
D_2: D_A leds led.webots 2 device "front left led" device "front right led" K_1/
K_1: K_A A_L 1 rate_hz 10/
D_3: D_M bat battery.webots 1 capacity_wh 50/
D_4: D_C radio radio.webots 2 channel 1 range_m 200 P_1/
P_1: P_R SIM "emitter" T 0/
