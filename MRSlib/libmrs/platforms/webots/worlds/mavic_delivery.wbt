DEF PKG_1001 Solid {
  translation -6.0 0.0 0.125
  name "package 1001"
  description "tag 1001 5 45 0 3 0.395"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.72 0.53 0.32
        roughness 1
        metalness 0
      }
      geometry DEF BOX Box {
        size 0.3 0.3 0.25
      }
    }
    Connector {
      translation 0 0 0.225
      rotation 0 1 0 -1.5708
      name "loop"
      model "sling"
      type "passive"
      distanceTolerance 0.35
      axisTolerance 1.0
      rotationTolerance 0
      numberOfRotations 0
      snap FALSE
    }
  ]
  boundingObject USE BOX
  physics Physics {
    density -1
    mass 0.395
  }
}

