Robot {
  translation 0 -14 0.5
  name "issuer"
  controller "mrs_issuer"
  controllerArgs [
    "../../worlds/mavic_delivery_mission.mrs"
    "../../worlds/delivery_12.mrsl"
    "../../worlds/mavic_delivery_results.csv"
  ]
  supervisor TRUE
  children [
    Emitter {
      name "emitter"
      channel 1
    }
    Receiver {
      name "receiver"
      channel 1
    }
  ]
}
