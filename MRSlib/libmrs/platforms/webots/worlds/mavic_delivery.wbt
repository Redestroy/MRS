Mavic2Pro {
  translation -4.0 -8.0 0.1
  name "r1"
  controller "mrs_uav"
  controllerArgs [
    "1"
    "rta"
    "mavic_sling_webots.mrsd"
    "mavic_sling_webots.mrsp"
    "uav_behaviours.mrsb"
    "--zones"
    "../../worlds/delivery_zones.csv"
    "--pad"
    "101,10,-8,16,-8"
  ]
  supervisor TRUE
  battery [
    180000, 180000, 3000
  ]
  bodySlot [
    Emitter {
      name "emitter"
      channel 1
    }
    Receiver {
      name "receiver"
      channel 1
    }
    BallJoint {
      jointParameters BallJointParameters {
        anchor -0.075 0 -0.06
        dampingConstant 0.2
      }
      endPoint Solid {
        translation -0.075 0 -1.060
        name "line"
        children [
          Shape {
            appearance PBRAppearance {
              baseColor 0.1 0.1 0.1
              roughness 1
              metalness 0
            }
            geometry Cylinder {
              height 1.900
              radius 0.004
            }
          }
          SliderJoint {
            jointParameters JointParameters {
              axis 0 0 1
              springConstant 150
              dampingConstant 4
              minStop -0.2
              maxStop 0.05
            }
            device [
              PositionSensor {
                name "load cell"
              }
            ]
            endPoint Solid {
              translation 0 0 -1.000
              name "hook body"
              children [
                Shape {
                  appearance PBRAppearance {
                    baseColor 0.8 0.6 0.1
                    metalness 0.5
                  }
                  geometry Sphere {
                    radius 0.03
                  }
                }
                Connector {
                  rotation 0 1 0 1.5708
                  name "hook"
                  model "sling"
                  type "active"
                  autoLock FALSE
                  distanceTolerance 0.35
                  axisTolerance 1.0
                  rotationTolerance 0
                  numberOfRotations 0
                  snap FALSE
                }
              ]
              physics Physics {
                density -1
                mass 0.1
              }
            }
          }
        ]
        physics Physics {
          density -1
          mass 0.02
        }
      }
    }
  ]
}

